{
  "name": "octarinepress/octarinepress",
  "description": "OctarinePress Theme",
  "minimum-stability": "stable",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Szymon Hałat",
      "email": "szymon@halat.dev"
    }
  ],
  "autoload": {
    "psr-4": {
      "octarinepress\\": "./inc"
    },
    "files": [
      "./inc/Constants.php",
      "./inc/Helpers.php"
    ]
  },
  "require-dev": {
    "pestphp/pest": "^2.8",
    "tightenco/duster": "^2.6",
    "szepeviktor/phpstan-wordpress": "^1.3"
  },
  "require": {
    "php": "^8.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "suggest": {
    "htmlburger/carbon-fields": "Optional custom fields integration, bootstrapped by Setup\\BootFields."
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
