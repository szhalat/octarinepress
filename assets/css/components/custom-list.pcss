.custom-list-block__list {
    list-style: none;
}

.custom-list-block__item {
    font-size: 1.5rem;
    line-height: 135%;
    display: grid;
    grid-template-columns: 43px 1fr;
    column-gap: 2.5rem;
    align-items: start;
    padding-bottom: 2rem;
    padding-top: 2rem;

    &:not(:last-of-type){
        border-bottom: 1px solid var(--color-white);

    }
}